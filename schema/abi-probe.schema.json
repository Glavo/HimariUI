{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema/abi-probe.schema.json",
  "title": "HimariUI native ABI probe protocol version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "fixtures", "target", "compiler", "types", "aggregates", "callbacks", "checks"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "target": { "$ref": "#/$defs/target" },
    "compiler": { "$ref": "#/$defs/compiler" },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layout" }
    },
    "aggregates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/aggregate" }
    },
    "callbacks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/callback" }
    },
    "checks": { "$ref": "#/$defs/checks" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "positiveSize": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatingSystem", "architecture", "byteOrder", "addressSize", "addressAlignment"],
      "properties": {
        "operatingSystem": { "enum": ["linux", "windows", "macos"] },
        "architecture": { "enum": ["x86_64", "arm64"] },
        "byteOrder": { "enum": ["little_endian", "big_endian"] },
        "addressSize": { "$ref": "#/$defs/positiveSize" },
        "addressAlignment": { "$ref": "#/$defs/positiveSize" }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "major", "minor", "patch"],
      "properties": {
        "family": { "enum": ["clang", "gcc", "msvc", "unknown"] },
        "major": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "minor": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "patch": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "byteSize", "alignment"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "byteSize": { "$ref": "#/$defs/positiveSize" },
        "alignment": { "$ref": "#/$defs/positiveSize" }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "byteSize", "alignment", "fields"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "byteSize": { "$ref": "#/$defs/positiveSize" },
        "alignment": { "$ref": "#/$defs/positiveSize" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "byteOffset", "bitOffset", "bitWidth"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "byteOffset": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "bitOffset": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0, "maximum": 2147483647 }
          ]
        },
        "bitWidth": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          ]
        }
      }
    },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "callingConvention", "pointerSize", "pointerAlignment", "invocationResult"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "callingConvention": { "enum": ["system", "cdecl", "stdcall", "thiscall"] },
        "pointerSize": { "$ref": "#/$defs/positiveSize" },
        "pointerAlignment": { "$ref": "#/$defs/positiveSize" },
        "invocationResult": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structureReturnLeft", "structureReturnRight", "variadicSum"],
      "properties": {
        "structureReturnLeft": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "structureReturnRight": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "variadicSum": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      }
    }
  }
}
