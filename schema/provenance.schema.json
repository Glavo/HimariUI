{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himari-ui.dev/schema/provenance-v1.json",
  "title": "HimariUI provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "entries"],
  "properties": {
    "$schema": { "const": "schema/provenance.schema.json" },
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "source", "version", "license", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]" },
        "kind": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "format": "uri", "pattern": "^https://" },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
