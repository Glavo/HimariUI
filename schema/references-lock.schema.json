{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himari-ui.dev/schema/references-lock-v1.json",
  "title": "HimariUI normative reference lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "reviewed", "policy", "sources"],
  "properties": {
    "$schema": { "const": "schema/references-lock.schema.json" },
    "schemaVersion": { "const": 1 },
    "reviewed": { "type": "string", "format": "date" },
    "policy": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "title", "url", "pinKind", "pin", "retrieved"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "category": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "pinKind": { "enum": ["edition", "release", "commit", "retrieval-date"] },
        "pin": { "type": "string", "minLength": 1 },
        "retrieved": { "type": "string", "format": "date" }
      }
    }
  }
}
